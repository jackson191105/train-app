<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>ExpressRail - Train Booking</title>
<style>
    * { margin:0; padding:0; box-sizing:border-box; font-family: Arial,sans-serif; }
    body {
        height: 100vh;
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
                    url("https://images.unsplash.com/photo-1504376379689-8d54347b26c3?auto=format&fit=crop&w=1950&q=80") no-repeat center center/cover;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .container {
        background: rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        padding: 30px;
        width: 400px;
        border-radius: 15px;
        color: white;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }
    h1 { text-align:center; margin-bottom:20px; font-size:28px; }
    select,input,button { width:100%; padding:12px; margin:10px 0; border-radius:8px; border:none; font-size:14px; }
    button { background:#ff4b2b; color:white; font-weight:bold; cursor:pointer; transition:0.3s; }
    button:hover { background:#ff2e00; }
    .train-card {
        background: rgba(255,255,255,0.2);
        padding:15px;
        margin-top:15px;
        border-radius:10px;
    }
    .no-result { margin-top:15px; color:#ffdede; text-align:center; }
</style>
</head>
<body>

<div class="container">
    <h1>ExpressRail</h1>

    <form id="searchForm">
        <select id="from" required>
            <option value="">From Station</option>
            <option value="New York">New York</option>
            <option value="Boston">Boston</option>
        </select>

        <select id="to" required>
            <option value="">To Station</option>
            <option value="Chicago">Chicago</option>
            <option value="Washington">Washington</option>
        </select>

        <input type="date" id="date" required>

        <button type="submit">Search Train</button>
    </form>

    <div id="results"></div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {

    // Train data (make sure values exactly match dropdown values)
    const trains = [
        { name: "Express 101", from: "New York", to: "Chicago", time: "10:00 AM", price: 80 },
        { name: "Speed Rail", from: "New York", to: "Chicago", time: "2:00 PM", price: 95 },
        { name: "Metro Express", from: "Boston", to: "Washington", time: "6:00 PM", price: 70 }
    ];

    const form = document.getElementById("searchForm");
    const resultsDiv = document.getElementById("results");

    form.addEventListener("submit", function(e) {
        e.preventDefault(); // Prevent page reload

        const fromValue = document.getElementById("from").value;
        const toValue = document.getElementById("to").value;

        // Clear previous results
        resultsDiv.innerHTML = "";

        // Filter trains
        const filteredTrains = trains.filter(train =>
            train.from === fromValue && train.to === toValue
        );

        if(filteredTrains.length === 0){
            resultsDiv.innerHTML = "<p class='no-result'>No trains found for this route.</p>";
            return;
        }

        // Display trains
        filteredTrains.forEach(train => {
            const card = document.createElement("div");
            card.classList.add("train-card");
            card.innerHTML = `
                <h3>${train.name}</h3>
                <p>${train.from} → ${train.to}</p>
                <p>Departure: ${train.time}</p>
                <p>Price: $${train.price}</p>
            `;
            resultsDiv.appendChild(card);
        });
    });

});
</script>

</body>
</html>
